# AI Dungeon Master — Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Configuration ──────────────────────────────────────────────────────────
# Choose: "ollama" (local/free) or "openai" (requires API key)
LLM_PROVIDER=ollama

# Ollama settings (default: local Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI settings (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Image Generation ───────────────────────────────────────────────────────────
# Choose: "placeholder" (no model needed) or "stable_diffusion" (requires SD)
IMAGE_PROVIDER=placeholder

# Stable Diffusion settings (only needed if IMAGE_PROVIDER=stable_diffusion)
# SD_API_URL=http://127.0.0.1:7860

# ── App Settings ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Memory Settings ────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
SESSION_TIMEOUT_MINUTES=60
