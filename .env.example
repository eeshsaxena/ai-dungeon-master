# AI Dungeon Master — Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Configuration ──────────────────────────────────────────────────────────
# "ollama"  — local Ollama instance (default)
# "openai"  — OpenAI API (requires key)
# "lora"    — fine-tuned local model with LoRA adapter (requires training first)
LLM_PROVIDER=ollama

# Ollama settings (default: local Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI settings (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Image Generation ───────────────────────────────────────────────────────────
# "procedural"      — fast Pillow renderer, no model (default)
# "diffusers"       — HuggingFace Stable Diffusion, GPU recommended
# "stable_diffusion"— AUTOMATIC1111 API (needs SD_API_URL running)
# "placeholder"     — colour/description only (legacy)
IMAGE_PROVIDER=procedural

# Diffusers settings (IMAGE_PROVIDER=diffusers)
# SD_MODEL_ID=runwayml/stable-diffusion-v1-5
# SD_STEPS=25          # inference steps (20-50 recommended)
# SD_CFG=7.5           # classifier-free guidance scale

# AUTOMATIC1111 settings (IMAGE_PROVIDER=stable_diffusion)
# SD_API_URL=http://127.0.0.1:7860

# ── App Settings ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Memory Settings ────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
SESSION_TIMEOUT_MINUTES=60

# ── TTS Voice Narration ────────────────────────────────────────────────────────
# "disabled" (default) | "coqui" | "pyttsx3" | "elevenlabs"
# TTS_PROVIDER=disabled
# Coqui model (GPU): tts_models/en/vctk/vits (multi-speaker, British voices)
# COQUI_MODEL=tts_models/en/vctk/vits
# TTS_VOICE=p273          # VCTK speaker ID for Coqui (p273 = British male)
# ElevenLabs:
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE=Rachel

# ── LoRA Narrator (LLM_PROVIDER=lora) ─────────────────────────────────────────
# Base model to load (must match what you trained on):
# LORA_BASE_MODEL=microsoft/phi-3-mini-4k-instruct
# Path to the saved LoRA adapter (produced by lora_train/train.py):
# LORA_ADAPTER_PATH=backend/lora_train/adapter

# ── Vector Store (RAG + NPC memory backend) ────────────────────────────────────
# "auto" (default): use Chroma if installed (pip install chromadb), else numpy
# "chroma": require Chroma; error if not installed
# "numpy": always use the flat numpy index (no extra install needed)
# VECTOR_BACKEND=auto
# EMBED_MODEL=all-MiniLM-L6-v2
