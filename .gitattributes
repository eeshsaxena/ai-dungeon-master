# Handle line endings automatically
* text=auto

# Force LF for these types (cross-platform consistency)
*.py    text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.env*  text eol=lf

# Binary files — don't touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pt    binary
*.pth   binary
*.bin   binary
*.ckpt  binary
*.safetensors binary
